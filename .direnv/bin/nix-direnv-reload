#!/usr/bin/env bash
set -e
if [[ ! -d "/home/jim/.local/share/Steam/steamapps/common/HITMAN 3/h3mod" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/jim/.local/share/Steam/steamapps/common/HITMAN 3/h3mod")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/jim/.local/share/Steam/steamapps/common/HITMAN 3/h3mod" true
